{
  "name": "evolyn",
  "version": "0.1.0",
  "private": true,
  "description": "Evolyn — an agent that learns how to become a better agent.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx --tsconfig tsconfig.json scripts/smoke.ts",
    "reset": "tsx --tsconfig tsconfig.json scripts/reset-demo.ts",
    "demo": "tsx --tsconfig tsconfig.json scripts/reset-demo.ts && next dev",
    "demo-flow": "tsx --tsconfig tsconfig.json scripts/demo-flow.ts"
  },
  "dependencies": {
    "next": "^15.5.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
